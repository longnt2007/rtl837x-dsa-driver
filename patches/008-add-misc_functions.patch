+enum rtl8372n_rma_action {
+    RTL8372N_RMA_ACTION_FORWARD = 0,
+    RTL8372N_RMA_ACTION_TRAP_TO_CPU = 1,
+    RTL8372N_RMA_ACTION_DROP = 2,
+    RTL8372N_RMA_ACTION_FORWARD_EXCLUDE_CPU = 3,
+};
+
+static int rtl8372n_setup_stp_bpdu_trap(struct rtl837x_priv *priv)
+{
+    /*
+     * RMA index 0x00:
+     * Destination MAC 01:80:c2:00:00:00
+    * IEEE 802.1D STP / RSTP / MSTP BPDU.
+     *
+     * Trap packet to CPU so Linux bridge/STP receives it.
+     * Do not let ASIC forward/flood it between user ports.
+     */
+    return rtl837x_reg_bits_write(priv,
+        RTL8373_RMA_OP_CTRL_00_ADDR,
+        RTL8373_RMA_OP_CTRL_00_RMA_ACT_00_MASK,
+        RTL8372N_RMA_ACTION_TRAP_TO_CPU);
+}
+
+static void rtl8372n_teardown(struct dsa_switch *ds)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	int ret;
+
+	rtnl_lock();
+	switch (priv->tag_proto) {
+		case DSA_TAG_PROTO_MXL862_8021Q:
+			ret = rtl8372n_teardown_tag_8021q(ds);
+			break;
+		case DSA_TAG_PROTO_RTL8_4:
+			ret = rtl8372n_teardown_tag_rtl(ds);
+			break;
+		default:
+			ret = 0;
+			break;
+	}
+	rtnl_unlock();
+
+	if (ret)
+		dev_err(priv->dev, "[%s]: failed to tear down tag protocol: %d\n",
+			__func__, ret);
+}
+
+static int rtl8372n_devlink_info_get(struct dsa_switch *ds,
+				      struct devlink_info_req *req,
+				      struct netlink_ext_ack *extack)
+{
+	struct rtl837x_priv *priv = ds->priv;
+
+	if (!priv->chip_name)
+		return -ENODEV;
+
+	return devlink_info_version_fixed_put(req,
+			  DEVLINK_INFO_VERSION_GENERIC_ASIC_ID, priv->chip_name);
+}
+
+static void rtl8372n_get_pause_stats(struct dsa_switch *ds, int port,
+				      struct ethtool_pause_stats *pause_stats)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	const struct rtl837x_mib_counter *mib;
+
+	mutex_lock(&priv->mib_lock);
+
+	mib = &priv->mib_counters[RTL837X_MIB_dot3InPauseFrames];
+	priv->ops->get_mib_counter(priv, port, mib, &pause_stats->rx_pause_frames);
+
+	mib = &priv->mib_counters[RTL837X_MIB_dot3OutPauseFrames];
+	priv->ops->get_mib_counter(priv, port, mib, &pause_stats->tx_pause_frames);
+
+	mutex_unlock(&priv->mib_lock);
+}
