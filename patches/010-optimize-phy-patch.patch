+/*
+ * Bulk write phase of patch v008, applied once to every port in
+ * patch_mask via broadcast MDIO writes instead of once per port.
+ * This is a 1:1 mechanical port of the original patch_phy_v008()
+ * write sequence -- same registers, same order, same values -- only
+ * the transport (single phy -> phy_mask broadcast) changed. Table
+ * contents (rst_smtr_patch_..., n2_patch_..., uc2_patch_...,
+ * uc_patch_..., data_ram_patch_...) are untouched.
+ */
+static int patch_phys_v008_apply(struct rtl837x_priv *priv, u16 patch_mask)
+{
+	int ret;
