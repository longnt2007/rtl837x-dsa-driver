+/* ------------------------------------------------------------------
+ * Broadcast (phy_mask) variants of the SRAM helpers above.
+ *
+ * rtl837x_phys_write_c45() already accept a phy_mask and broadcasts
+ * the value to every port in one MDIO transaction -- that part is free
+ * and requires no assumption at all, since a full-register write
+ * discards whatever was there before regardless of port.  
+ *
+ * For a MASKED write narrower than the full register (a true
+ * read-modify-write), we do NOT broadcast: without Realtek
+ * documentation or verified testing confirming the unmasked bits are
+ * identical across every PHY in phy_mask, assuming so and broadcasting
+ * a value read from a single representative port risks silently
+ * corrupting unrelated bits on the other ports. Fall back to a
+ * per-PHY loop calling the original, unmodified
+ * rtl837x_phy_bits_write_c45() -- exact same semantics as the
+ * pre-patch code, just called once per set bit in phy_mask instead of
+ * being looped by the caller.
+ *
+ * Net effect: every call site in patch_phys_v008_apply() below is
+ * unchanged -- only this dispatch changes -- and the big patch tables
+ * (rst_smtr_patch_*, n2_patch_*, uc2_patch_*, uc_patch_*), which were
+ * always full-register writes via rtl837x_phys_write_c45() and never
+ * touched this function at all, keep their full broadcast speedup.
+ * ------------------------------------------------------------------ */
+
+static int rtl837x_phys_bits_write_c45(struct rtl837x_priv *priv, u16 phy_mask,
+					int devad, int regnum, u16 mask, u16 data)
+{
+	int ret;
+
+	if (!phy_mask)
+		return 0;
+
+	/* Full-register write: safe to broadcast, no read/assumption
+	 * of any kind involved. */
+	if (mask == 0xffff)
+		return rtl837x_phys_write_c45(priv, phy_mask, devad, regnum, data);
+
+	/* Partial mask: a real read-modify-write. Preserve exact
+	 * per-PHY semantics with a plain loop rather than assuming
+	 * uniformity across ports. */
+	for (int p = 0; p < 8; p++) {
+		if (!(phy_mask & BIT(p)))
+			continue;
+		ret = rtl837x_phy_bits_write_c45(priv, p, devad, regnum, mask, data);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int uc1_sram_write_16b_mask(struct rtl837x_priv *priv, u16 phy_mask, u16 addr, u16 val)
+{
+	int ret;
+	ret = rtl837x_phys_write_c45(priv, phy_mask, 31, 0xa436, addr);
+	if (ret) return ret;
+	ret = rtl837x_phys_write_c45(priv, phy_mask, 31, 0xa438, val);
+	if (ret) return ret;
+	return 0;
+}
+
+static int uc1_sram_write_8b_mask(struct rtl837x_priv *priv, u16 phy_mask, u16 addr, u16 val)
+{
+	int ret;
+	ret = rtl837x_phys_write_c45(priv, phy_mask, 31, 0xa436, addr);
+	if (ret) return ret;
+	ret = rtl837x_phys_bits_write_c45(priv, phy_mask, 31, 0xa438, 0xff<<8, val);
+	if (ret) return ret;
+	return 0;
+}
+
+static int uc2_sram_write_8b_mask(struct rtl837x_priv *priv, u16 phy_mask, u16 addr, u16 val)
+{
+	int ret;
+	ret = rtl837x_phys_write_c45(priv, phy_mask, 31, 0xb87c, addr);
+	if (ret) return ret;
+	ret = rtl837x_phys_bits_write_c45(priv, phy_mask, 31, 0xb87e, 0xff<<8, val);
+	if (ret) return ret;
+	return 0;
+}
+
+/*
+ * Per-port eligibility check for patch v008. This CANNOT be broadcast:
+ * ic_ver/fw_ver are read back per-PHY and may legitimately differ
+ * between ports (e.g. a port already patched from a previous probe,
+ * or a port whose internal PHY reports a different ic_ver). Only the
+ * bulk WRITE sequence below is batched across ports.
+ */
+static int patch_phy_v008_needs_patch(struct rtl837x_priv *priv, int phy, bool *needs)
+{
+	int ret;
+	u16 ic_ver, fw_ver;
+	const u16 fw_ver_want = 0x008;
+
+	*needs = false;
+
+	ret = uc1_sram_read_8b(priv, phy, 0x0005, &ic_ver);
+	if (ret) return ret;
+	if (ic_ver != 2)
+		return 0;
+
+	ret = uc1_sram_read_16b(priv, phy, 0x801e, &fw_ver);
+	if (ret) return ret;
+
+	dev_dbg(priv->dev, "[%s]: port %d fw_ver read: 0x%04X want: 0x%04x\n",
+		__func__, phy, fw_ver, fw_ver_want);
+
+	*needs = (fw_ver != fw_ver_want);
+	return 0;
+}
+
+/*
+ * Wait for a status bit on every port in phy_mask. Reads cannot be
+ * broadcast (each port's status register is independent), so this
+ * still loops per-port -- but it only runs a handful of times per
+ * patch application, unlike the multi-thousand-entry table writes
+ * below, so the per-port loop cost here is negligible in comparison.
+ */
+static int patch_phy_v008_wait_mask(struct rtl837x_priv *priv, u16 phy_mask,
+				     u16 reg, u16 bitmask, u16 want)
+{
+	int ret, ret1;
+	u16 tmp16;
+
+	for (int p = 0; p < 8; p++) {
+		if (!(phy_mask & BIT(p)))
+			continue;
+
+		ret = read_poll_timeout(rtl837x_phy_bits_read_c45, ret1,
+				  (tmp16 == want) || (ret1),
+				  50, 250*1000, true,
+				  priv, p, 31, reg, bitmask, &tmp16);
+		if (ret) return ret;
+		if (ret1) return ret1;
+	}
+	return 0;
+}
