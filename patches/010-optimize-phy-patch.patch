+	}
+	// n0_patch_RL6818C_230703 stop
+
+	// n2_patch_6818C_231206 start
+	for (int i=0; i<sizeof(n2_patch_6818C_231206_patch)/(sizeof(u16)*2); i++)
+	{
+		ret = rtl837x_phys_write_c45(priv, patch_mask, 31,
+			  n2_patch_6818C_231206_patch[i][0],
+			  n2_patch_6818C_231206_patch[i][1]
+			);
+		if (ret) return ret;
+	}
+	// n2_patch_6818C_231206 stop
+
+	// uc2_patch_6818C_231206 start
+	for (int i=0; i<sizeof(uc2_patch_6818C_231206_patch)/(sizeof(u16)*2); i++)
+	{
+		ret = rtl837x_phys_write_c45(priv, patch_mask, 31,
+			  uc2_patch_6818C_231206_patch[i][0],
+			  uc2_patch_6818C_231206_patch[i][1]
+			);
+		if (ret) return ret;
+	}
+	// uc2_patch_6818C_231206 stop
+
+	ret = rtl837x_phys_bits_write_c45(priv, patch_mask, 31, 0xb820, 1<<7, 0);
+	if (ret) return ret;
+
+	// uc_patch_6818C_221117 start
+	for (int i=0; i<sizeof(uc_patch_6818C_221117_patch)/(sizeof(u16)*2); i++)
+	{
+		ret = rtl837x_phys_write_c45(priv, patch_mask, 31,
+			  uc_patch_6818C_221117_patch[i][0],
+			  uc_patch_6818C_221117_patch[i][1]
+			);
+		if (ret) return ret;
+	}
+	// uc_patch_6818C_221117 stop
