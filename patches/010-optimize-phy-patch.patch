+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd6, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd7, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd8, 0x0c);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd9, 0x80);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fda, 0x0a);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fdb, 0x19);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fdc, 0x19);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fdd, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fde, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fdf, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fe0, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fe1, 0x20);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fe2, 0x0c);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd3, 0x00);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd4, 0x15);
+	if (ret) return ret;
+	ret = uc2_sram_write_8b_mask(priv, patch_mask, 0x8fd5, 0x15);
