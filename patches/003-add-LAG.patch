+static void rtl8372n_port_fast_age(struct dsa_switch *ds, int port)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	int ret;
+
+	ret = rtl8372n_l2_flush_port(priv, port);
+	if (ret)
+		dev_err(priv->dev, "failed to flush dynamic FDB on port %d: %d\n",
+			port, ret);
+}
+
+/*
+ * Program one RTL8372N trunk group.
+ *
+ * The hardware trunk member register contains only active TX-enabled
+ * members. lag_port_mask[] separately retains all configured members so
+ * static FDB programming never falls back to the CPU port while all links
+ * in a LAG are temporarily inactive.
+ *
+ * Caller must hold chip_data->config_lock.
+ */
+static int rtl8372n_lag_group_program(struct rtl837x_priv *priv,
+				      unsigned int group, u16 members,
+				      u8 hash)
+{
+	u32 val;
+	int ret;
+
+	if (group >= RTL8372N_TRUNK_GROUPS)
+		return -EINVAL;
+
+	members &= RTL8372N_VLAN_MEMBER_MASK;
+	hash &= RTL8373_TRK_HASH_CTRL_HASH_MSK_MASK;
+
+	ret = rtl837x_reg_bits_write(priv, RTL8373_TRK_HASH_CTRL_ADDR(group),
+				     RTL8373_TRK_HASH_CTRL_HASH_MSK_MASK,
+				     hash);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_bits_write(priv, RTL8373_TRK_MBR_CTRL_ADDR(group),
+				     RTL8373_TRK_MBR_CTRL_TRK_PMSK_MASK,
+				     members);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_bits_read(priv, RTL8373_TRK_HASH_CTRL_ADDR(group),
+				    RTL8373_TRK_HASH_CTRL_HASH_MSK_MASK,
+				    &val);
+	if (ret)
+		return ret;
+	if (val != hash)
+		return -EIO;
+
+	ret = rtl837x_reg_bits_read(priv, RTL8373_TRK_MBR_CTRL_ADDR(group),
+				    RTL8373_TRK_MBR_CTRL_TRK_PMSK_MASK,
+				    &val);
+	if (ret)
+		return ret;
+
+	return val == members ? 0 : -EIO;
+}
+
+static u16 rtl8372n_lag_tx_mask(struct dsa_switch *ds,
+				 const struct dsa_lag *lag)
+{
+	struct dsa_port *dp;
+	u16 mask = 0;
+
+	dsa_lag_foreach_port(dp, ds->dst, lag) {
+		if (dp->ds != ds || !dp->lag_tx_enabled)
+			continue;
+
+		if (!rtl8372n_port_is_user(ds, dp->index))
+			continue;
+
+		mask |= BIT(dp->index);
+	}
+
+	return mask;
+}
+
+/*
+ * Select a physical port for a static FDB entry belonging to a trunk.
+ *
+ * Prefer an active transmitting member. If all members are temporarily
+ * inactive, use the first configured user member. Do not ever return the
+ * CPU port as a fallback.
+ */
+static int rtl8372n_lag_fdb_port(u16 active_mask, u16 member_mask)
+{
+	u16 candidates = active_mask ? active_mask : member_mask;
+
+	if (!candidates)
+		return -ENODEV;
+
+	return __ffs(candidates);
+}
+
+/*
+ * Preserve the existing MT7988 DSA-802.1Q FDB behaviour. Bridge FDB VID 0
+ * is materialized once for every standalone DSA S-VID; non-zero bridge VID
+ * remains owned by DSA and therefore is ignored, just as in
+ * rtl8372n_port_fdb_add().
+ *
+ * Caller must hold chip_data->config_lock.
+ */
+static int rtl8372n_lag_fdb_program_locked(struct dsa_switch *ds, int port,
+					    const unsigned char *addr, u16 vid,
+					    bool bridge_db)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	int ret;
+
+	if (!rtl8372n_port_is_user(ds, port))
+		return -EINVAL;
+
+	if (bridge_db &&
+	    priv->tag_proto == DSA_TAG_PROTO_MXL862_8021Q) {
+		if (vid)
+			return 0;
+
+		dsa_switch_for_each_user_port(dp, ds) {
+			ret = rtl8372n_port_fdb_static_add(priv, port, addr,
+					dsa_tag_8021q_standalone_vid(dp));
+			if (ret)
+				return ret;
+		}
+
+		return 0;
+	}
+
+	return rtl8372n_port_fdb_static_add(priv, port, addr, vid);
+}
+
+static int rtl8372n_lag_fdb_delete_locked(struct dsa_switch *ds,
+					   const unsigned char *addr, u16 vid,
+					   bool bridge_db)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct dsa_port *dp;
+	int ret;
+
+	if (bridge_db &&
+	    priv->tag_proto == DSA_TAG_PROTO_MXL862_8021Q) {
+		if (vid)
+			return 0;
+
+		dsa_switch_for_each_user_port(dp, ds) {
+			ret = rtl8372n_port_fdb_static_del(priv, addr,
+					dsa_tag_8021q_standalone_vid(dp));
+			if (ret)
+				return ret;
+		}
+
+		return 0;
+	}
+
+	return rtl8372n_port_fdb_static_del(priv, addr, vid);
+}
+
+/*
+ * dsa_lag->fdbs is protected by lag->fdb_lock. All callers of this helper
+ * must hold that lock before config_lock, following this lock order:
+ *
+ *   lag->fdb_lock -> chip_data->config_lock -> regmap/map_lock -> MDIO lock
+ */
+static int rtl8372n_lag_fdb_move_locked(struct dsa_switch *ds,
+					struct dsa_lag *lag, int port)
+{
+	struct dsa_mac_addr *fdb;
+	int ret;
+
+	if (!lag)
+		return 0;
+
+	if (!rtl8372n_port_is_user(ds, port))
+		return -ENODEV;
+
+	list_for_each_entry(fdb, &lag->fdbs, list) {
+		ret = rtl8372n_lag_fdb_program_locked(ds, port, fdb->addr,
+						      fdb->vid, true);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl8372n_lag_fdb_clear_locked(struct dsa_switch *ds,
+					 struct dsa_lag *lag)
+{
+	struct dsa_mac_addr *fdb;
+	int ret;
+
+	if (!lag)
+		return 0;
+
+	list_for_each_entry(fdb, &lag->fdbs, list) {
+		ret = rtl8372n_lag_fdb_delete_locked(ds, fdb->addr,
+						     fdb->vid, true);
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static void rtl8372n_lag_fdb_restore_locked(struct dsa_switch *ds,
+					     struct dsa_lag *lag,
+					     int old_port)
+{
+	int ret;
+
+	if (old_port >= 0)
+		ret = rtl8372n_lag_fdb_move_locked(ds, lag, old_port);
+	else
+		ret = rtl8372n_lag_fdb_clear_locked(ds, lag);
+
+	if (ret)
+		dev_err(ds->dev, "failed to restore RTL8372N LAG FDB state: %d\n",
+			ret);
+}
+
+/*
+ * Program the hardware trunk state and move its static FDB entries when
+ * the selected FDB destination changes.
+ *
+ * Caller must hold both lag->fdb_lock, if lag is non-NULL, and
+ * chip_data->config_lock.
+ */
+static int rtl8372n_lag_update_locked(struct dsa_switch *ds,
+				      unsigned int group, u16 new_members,
+				      u16 new_active, u8 new_hash,
+				      struct dsa_lag *lag)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	u16 old_members;
+	u16 old_active;
+	u8 old_hash;
+	int old_port;
+	int new_port;
+	bool fdb_touched = false;
+	int ret;
+
+	if (group >= RTL8372N_TRUNK_GROUPS)
+		return -EINVAL;
+
+	if (new_active & ~new_members)
+		return -EINVAL;
+
+	old_members = chip_data->lag_port_mask[group];
+	old_active = chip_data->lag_active_mask[group];
+	old_hash = chip_data->lag_hash[group];
+
+	old_port = rtl8372n_lag_fdb_port(old_active, old_members);
+	new_port = rtl8372n_lag_fdb_port(new_active, new_members);
+
+	/*
+	 * A group with no configured members must not retain static FDB
+	 * entries pointing at a departed user port. DSA will subsequently
+	 * remove its software FDB records; repeated delete is harmless.
+	 */
+	if (!new_members) {
+		ret = rtl8372n_lag_fdb_clear_locked(ds, lag);
+		if (ret) {
+			rtl8372n_lag_fdb_restore_locked(ds, lag, old_port);
+			return ret;
+		}
+
+		fdb_touched = true;
+	} else if (old_port != new_port) {
+		ret = rtl8372n_lag_fdb_move_locked(ds, lag, new_port);
+		if (ret) {
+			rtl8372n_lag_fdb_restore_locked(ds, lag, old_port);
+			return ret;
+		}
+
+		fdb_touched = true;
+	}
+
+	ret = rtl8372n_lag_group_program(priv, group, new_active, new_hash);
+	if (!ret) {
+		chip_data->lag_active_mask[group] = new_active;
+		chip_data->lag_hash[group] = new_hash;
+		return 0;
+	}
+
+	if (fdb_touched)
+		rtl8372n_lag_fdb_restore_locked(ds, lag, old_port);
+
+	if (rtl8372n_lag_group_program(priv, group, old_active, old_hash))
+		dev_err(ds->dev,
+			"failed to restore RTL8372N trunk group %u after error\n",
+			group);
+
+	return ret;
+}
+
+static struct dsa_lag *rtl8372n_lag_find(struct dsa_switch *ds,
+					  const struct dsa_lag *lag)
+{
+	struct dsa_port *dp;
+
+	dsa_switch_for_each_user_port(dp, ds) {
+		if (dp->lag && dp->lag->dev == lag->dev)
+			return dp->lag;
+	}
+
+	return NULL;
+}
+
+static int rtl8372n_lag_hash(struct netdev_lag_upper_info *info, u8 *hash,
+			      struct netlink_ext_ack *extack)
+{
+	if (info->tx_type != NETDEV_LAG_TX_TYPE_HASH) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "RTL8372N only supports hash-based LAGs");
+		return -EOPNOTSUPP;
+	}
+
+	switch (info->hash_type) {
+	case NETDEV_LAG_HASH_L2:
+		*hash = RTL8372N_TRUNK_HASH_SMAC |
+			RTL8372N_TRUNK_HASH_DMAC;
+		break;
+	case NETDEV_LAG_HASH_L23:
+		*hash = RTL8372N_TRUNK_HASH_SMAC |
+			RTL8372N_TRUNK_HASH_DMAC |
+			RTL8372N_TRUNK_HASH_SIP |
+			RTL8372N_TRUNK_HASH_DIP;
+		break;
+	case NETDEV_LAG_HASH_L34:
+		*hash = RTL8372N_TRUNK_HASH_SIP |
+			RTL8372N_TRUNK_HASH_DIP |
+			RTL8372N_TRUNK_HASH_L4_SPORT |
+			RTL8372N_TRUNK_HASH_L4_DPORT;
+		break;
+	default:
+		NL_SET_ERR_MSG_MOD(extack,
+				   "unsupported RTL8372N LAG hash policy");
+		return -EOPNOTSUPP;
+	}
+
+	return 0;
+}
+
+static int rtl8372n_port_lag_join(struct dsa_switch *ds, int port,
+				  struct dsa_lag lag,
+				  struct netdev_lag_upper_info *info,
+				  struct netlink_ext_ack *extack)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	struct dsa_lag *live_lag;
+	u16 new_members;
+	u16 new_active;
+	u8 hash;
+	unsigned int group;
+	unsigned int i;
+	int ret;
+
+	if (!rtl8372n_port_is_user(ds, port)) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "RTL8372N LAG members must be DSA user ports");
+		return -EOPNOTSUPP;
+	}
+
+	if (!lag.id || lag.id > RTL8372N_TRUNK_GROUPS) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "RTL8372N supports four LAG groups");
+		return -ENOSPC;
+	}
+
+	ret = rtl8372n_lag_hash(info, &hash, extack);
+	if (ret)
+		return ret;
+
+	group = lag.id - 1;
+	live_lag = dsa_to_port(ds, port)->lag;
+
+	if (live_lag)
+		mutex_lock(&live_lag->fdb_lock);
+	mutex_lock(&chip_data->config_lock);
+
+	for (i = 0; i < RTL8372N_TRUNK_GROUPS; i++) {
+		if (i != group && (chip_data->lag_port_mask[i] & BIT(port))) {
+			ret = -EBUSY;
+			goto out_unlock;
+		}
+	}
+
+	new_members = chip_data->lag_port_mask[group] | BIT(port);
+	if (hweight16(new_members) > RTL8372N_TRUNK_PORTS_MAX) {
+		NL_SET_ERR_MSG_MOD(extack,
+				   "RTL8372N supports four ports per LAG");
+		ret = -ENOSPC;
+		goto out_unlock;
+	}
+
+	new_active = rtl8372n_lag_tx_mask(ds, &lag) & new_members;
+
+	ret = rtl8372n_lag_update_locked(ds, group, new_members, new_active,
+					 hash, live_lag);
+	if (!ret)
+		chip_data->lag_port_mask[group] = new_members;
+
+out_unlock:
+	mutex_unlock(&chip_data->config_lock);
+	if (live_lag)
+		mutex_unlock(&live_lag->fdb_lock);
+
+	return ret;
+}
+
+static int rtl8372n_port_lag_change(struct dsa_switch *ds, int port)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	struct dsa_port *dp;
+	struct dsa_lag *lag;
+	u16 new_active;
+	unsigned int group;
+	int ret;
+
+	if (!rtl8372n_port_is_user(ds, port))
+		return -EOPNOTSUPP;
+
+	dp = dsa_to_port(ds, port);
+	lag = dp->lag;
+	if (!lag || !lag->id || lag->id > RTL8372N_TRUNK_GROUPS)
+		return -EINVAL;
+
+	group = lag->id - 1;
+
+	mutex_lock(&lag->fdb_lock);
+	mutex_lock(&chip_data->config_lock);
+
+	new_active = rtl8372n_lag_tx_mask(ds, lag) &
+		     chip_data->lag_port_mask[group];
+
+	if (new_active == chip_data->lag_active_mask[group]) {
+		ret = 0;
+		goto out_unlock;
+	}
+
+	/*
+	 * Flush learned entries before removing an active TX member. Static
+	 * FDB entries are migrated by rtl8372n_lag_update_locked().
+	 */
+	if ((chip_data->lag_active_mask[group] & BIT(port)) &&
+	    !(new_active & BIT(port))) {
+		ret = rtl8372n_l2_flush_port(priv, port);
+		if (ret)
+			goto out_unlock;
+	}
+
+	ret = rtl8372n_lag_update_locked(ds, group,
+					 chip_data->lag_port_mask[group],
+					 new_active,
+					 chip_data->lag_hash[group],
+					 lag);
+
+out_unlock:
+	mutex_unlock(&chip_data->config_lock);
+	mutex_unlock(&lag->fdb_lock);
+
+	return ret;
+}
+
+static int rtl8372n_port_lag_leave(struct dsa_switch *ds, int port,
+				   struct dsa_lag lag)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	struct dsa_lag *live_lag;
+	u16 new_members;
+	u16 new_active;
+	u8 new_hash;
+	unsigned int group;
+	int ret;
+
+	if (!rtl8372n_port_is_user(ds, port))
+		return -EOPNOTSUPP;
+
+	if (!lag.id || lag.id > RTL8372N_TRUNK_GROUPS)
+		return -EINVAL;
+
+	group = lag.id - 1;
+	live_lag = rtl8372n_lag_find(ds, &lag);
+
+	if (live_lag)
+		mutex_lock(&live_lag->fdb_lock);
+	mutex_lock(&chip_data->config_lock);
+
+	if (!(chip_data->lag_port_mask[group] & BIT(port))) {
+		ret = 0;
+		goto out_unlock;
+	}
+
+	new_members = chip_data->lag_port_mask[group] & ~BIT(port);
+	new_active = rtl8372n_lag_tx_mask(ds, &lag) & new_members;
+	new_hash = new_members ? chip_data->lag_hash[group] : 0;
+
+	if (chip_data->lag_active_mask[group] & BIT(port)) {
+		ret = rtl8372n_l2_flush_port(priv, port);
+		if (ret)
+			goto out_unlock;
+	}
+
+	ret = rtl8372n_lag_update_locked(ds, group, new_members, new_active,
+					 new_hash, live_lag);
+	if (!ret)
+		chip_data->lag_port_mask[group] = new_members;
+
+out_unlock:
+	mutex_unlock(&chip_data->config_lock);
+	if (live_lag)
+		mutex_unlock(&live_lag->fdb_lock);
+
+	return ret;
+}
+
+/*
+ * DSA serializes updates to lag->fdbs with lag->fdb_lock before invoking
+ * lag_fdb_add() and lag_fdb_del(). These callbacks only acquire config_lock,
+ * preserving the lock order used by port_lag_{join,change,leave}().
+ */
+static int rtl8372n_lag_fdb_add(struct dsa_switch *ds, struct dsa_lag lag,
+				const unsigned char *addr, u16 vid,
+				struct dsa_db db)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	unsigned int group;
+	int port;
+	int ret;
+
+	if (db.type != DSA_DB_PORT && db.type != DSA_DB_BRIDGE)
+		return -EOPNOTSUPP;
+
+	if (!lag.id || lag.id > RTL8372N_TRUNK_GROUPS)
+		return -EINVAL;
+
+	group = lag.id - 1;
+
+	mutex_lock(&chip_data->config_lock);
+
+	port = rtl8372n_lag_fdb_port(chip_data->lag_active_mask[group],
+				     chip_data->lag_port_mask[group]);
+	if (port < 0) {
+		ret = port;
+		goto out_unlock;
+	}
+
+	ret = rtl8372n_lag_fdb_program_locked(ds, port, addr, vid,
+					      db.type == DSA_DB_BRIDGE);
+
+out_unlock:
+	mutex_unlock(&chip_data->config_lock);
+
+	return ret;
+}
+
+static int rtl8372n_lag_fdb_del(struct dsa_switch *ds, struct dsa_lag lag,
+				const unsigned char *addr, u16 vid,
+				struct dsa_db db)
