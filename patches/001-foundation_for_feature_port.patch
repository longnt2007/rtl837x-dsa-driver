+	/*
+	 * Serializes advanced feature transactions which program more than
+	 * one RTL8372N register. This lock must remain separate from the
+	 * regmap lock: config_lock protects feature state and transaction
+	 * boundaries, while priv->map_lock serializes individual regmap I/O.
+	 *
+	 * Lock ordering for future feature code:
+	 *
+	 *   config_lock -> regmap/map_lock -> MDIO bus lock
+	 *
+	 * Do not take config_lock from regmap callbacks.
+	 */
+	struct mutex config_lock;
+
+	/*
+	 * Set by rtl8372n_setup() only after DSA has validated that exactly
+	 * one CPU port exists. A negative value means the switch setup has
+	 * not completed successfully yet.
+	 */
+	int cpu_port;
 };
 
+/*
+ * Port roles are defined by DSA/Device Tree, not by a numerical range.
+ *
+ * In the MT7988 topology this accepts ports 4..8 when they are declared
+ * as DSA user ports, including SFP port 8, while rejecting CPU port 3.
+ * Future mirror, LAG, QoS, ACL and PTP callbacks must use this helper
+ * instead of open-coding a port range.
+ */
+static bool rtl8372n_port_is_user(struct dsa_switch *ds, int port)
+{
+	if (port < 0 || port >= ds->num_ports)
+		return false;
+
+	return dsa_is_user_port(ds, port);
+}
+
+/*
+ * Return the CPU port whose index was validated by rtl8372n_setup().
+ * This deliberately does not return the first CPU port encountered:
+ * doing so would hide a topology/setup mismatch from future advanced
+ * feature code.
+ */
+static int rtl8372n_get_cpu_port(struct dsa_switch *ds,
+				  struct dsa_port **cpu_dp)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	struct dsa_port *dp;
+
+	*cpu_dp = NULL;
+
+	if (chip_data->cpu_port < 0)
+		return -EAGAIN;
+
+	dsa_switch_for_each_cpu_port(dp, ds) {
+		if (dp->index != chip_data->cpu_port)
+			continue;
+
+		*cpu_dp = dp;
+		return 0;
+	}
+
+	return -ENODEV;
+}
