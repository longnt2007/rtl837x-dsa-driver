+struct rtl8372n_igbw_snapshot {
+	bool include_ifg;
+	bool flow_control;
+	bool enabled;
+	u32 rate;
+	u32 burst_high_on;
+	u32 burst_high_off;
+	u32 drop_threshold;
+};
+
+/*
+ * rtl837x_reg_bits_write() takes an unshifted field value and shifts it
+ * internally according to mask. Validate that the caller has supplied an
+ * unshifted value which fits entirely inside the selected field.
+ *
+ * All callers hold chip_data->config_lock.
+ */
+static int
+rtl8372n_igbw_field_write_verify_locked(struct rtl837x_priv *priv,
+					 u32 reg, u32 mask, u32 value)
+{
+	u32 field_max;
+	u32 readback;
+	int ret;
+
+	if (!mask)
+		return -EINVAL;
+
+	field_max = mask >> __ffs(mask);
+	if (value & ~field_max)
+		return -ERANGE;
+
+	ret = rtl837x_reg_bits_write(priv, reg, mask, value);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_bits_read(priv, reg, mask, &readback);
+	if (ret)
+		return ret;
+
+	return readback == value ? 0 : -EIO;
+}
+
+/*
+ * DROP_THR occupies the full 32-bit register word, unlike the two 31-bit
+ * burst threshold words. Full-word write/readback is therefore correct only
+ * for this register.
+ */
+static int
+rtl8372n_igbw_drop_write_verify_locked(struct rtl837x_priv *priv, int port,
+					u32 threshold)
+{
+	u32 readback;
+	int ret;
+
+	ret = rtl837x_reg_write(priv, RTL8373_IGBW_PORT_DROP_CTRL_ADDR(port),
+				threshold);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_read(priv, RTL8373_IGBW_PORT_DROP_CTRL_ADDR(port),
+			       &readback);
+	if (ret)
+		return ret;
+
+	return readback == threshold ? 0 : -EIO;
+}
+
+/*
+ * IGBW burst HIGH_ON and HIGH_OFF are physically represented as two
+ * consecutive 32-bit registers. Each has a 31-bit valid field; bit 31 is
+ * reserved and must not participate in write or readback comparisons.
+ */
+static int
+rtl8372n_igbw_burst_write_verify_locked(struct rtl837x_priv *priv, u32 reg,
+					 u32 burst)
+{
+	return rtl8372n_igbw_field_write_verify_locked(
+		priv, reg, RTL8372N_IGBW_BURST_FIELD_MASK, burst);
+}
+
+/*
+ * The token-bucket reset bit is software-cleared. Always attempt the clear,
+ * even if assertion or assertion readback failed: an MDIO error can occur
+ * after the switch has accepted the write.
+ */
+static int
+rtl8372n_igbw_reset_locked(struct rtl837x_priv *priv, int port)
+{
+	u32 reset_reg = RTL8373_IGBW_PORT_LB_RST_ADDR(port);
+	u32 reset_mask = RTL8373_IGBW_PORT_LB_RST_RST_MASK(port);
+	int ret;
+	int clear_ret;
+
+	ret = rtl8372n_igbw_field_write_verify_locked(priv, reset_reg,
+						       reset_mask, 1);
+
+	clear_ret = rtl8372n_igbw_field_write_verify_locked(priv, reset_reg,
+							     reset_mask, 0);
+	if (clear_ret)
+		dev_err(priv->dev,
+			"failed to clear ingress policer reset on port %d: %d\n",
+			port, clear_ret);
+
+	return ret ? ret : clear_ret;
+}
+
+static void rtl8372n_igbw_record_error(int *first_error, int error)
+{
+	if (!*first_error && error)
+		*first_error = error;
+}
+
+static int
+rtl8372n_igbw_snapshot_locked(struct rtl837x_priv *priv, int port,
+			       struct rtl8372n_igbw_snapshot *snapshot)
+{
+	u32 burst_reg = RTL8373_IGBW_PORT_BURST_CTRL_ADDR(port);
+	u32 value;
+	int ret;
+
+	memset(snapshot, 0, sizeof(*snapshot));
+
+	ret = rtl837x_reg_bits_read(priv, RTL8373_IGBW_CTRL_ADDR,
+				    RTL8373_IGBW_CTRL_INC_IFG_MASK, &value);
+	if (ret)
+		return ret;
+	snapshot->include_ifg = !!value;
+
+	ret = rtl837x_reg_bits_read(priv, RTL8373_IGBW_PORT_FC_CTRL_ADDR(port),
+				    RTL8373_IGBW_PORT_FC_CTRL_EN_MASK(port),
+				    &value);
+	if (ret)
+		return ret;
+	snapshot->flow_control = !!value;
+
+	ret = rtl837x_reg_bits_read(priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+				    RTL8373_IGBW_PORT_CTRL_BW_EN_MASK, &value);
+	if (ret)
+		return ret;
+	snapshot->enabled = !!value;
+
+	ret = rtl837x_reg_bits_read(priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+				    RTL8373_IGBW_PORT_CTRL_RATE_MASK,
+				    &snapshot->rate);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_bits_read(priv, burst_reg,
+				    RTL8372N_IGBW_BURST_FIELD_MASK,
+				    &snapshot->burst_high_on);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_bits_read(priv, burst_reg + 4,
+				    RTL8372N_IGBW_BURST_FIELD_MASK,
+				    &snapshot->burst_high_off);
+	if (ret)
+		return ret;
+
+	ret = rtl837x_reg_read(priv, RTL8373_IGBW_PORT_DROP_CTRL_ADDR(port),
+				    &snapshot->drop_threshold);
+	if (ret)
+		return ret;
+
+	return 0;
+}
+
+/*
+ * Restore only fields touched by ingress policer programming. In particular,
+ * IGBW_CTRL and IGBW_PORT_FC_CTRL are packed/shared registers, so restoring
+ * their complete 32-bit values would risk clobbering unrelated ports or
+ * global admission/bypass policy.
+ *
+ * This is best-effort rollback. Preserve the first failure but continue with
+ * every restoration step.
+ */
+static void
+rtl8372n_igbw_restore_locked(struct rtl837x_priv *priv, int port,
+			     const struct rtl8372n_igbw_snapshot *snapshot)
+{
+	u32 burst_reg = RTL8373_IGBW_PORT_BURST_CTRL_ADDR(port);
+	int first_error = 0;
+	int ret;
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_BW_EN_MASK, 0);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_drop_write_verify_locked(priv, port,
+						      snapshot->drop_threshold);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_burst_write_verify_locked(
+		priv, burst_reg, snapshot->burst_high_on);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_burst_write_verify_locked(
+		priv, burst_reg + 4, snapshot->burst_high_off);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_RATE_MASK, snapshot->rate);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_FC_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_FC_CTRL_EN_MASK(port),
+		snapshot->flow_control);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_CTRL_ADDR,
+		RTL8373_IGBW_CTRL_INC_IFG_MASK, snapshot->include_ifg);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_BW_EN_MASK, snapshot->enabled);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	if (first_error)
+		dev_err(priv->dev,
+			"failed to restore ingress policer state on port %d: %d\n",
+			port, first_error);
+}
+
+/*
+ * Program one port ingress policer. The unit is 16 kbit/s and tc police
+ * supplies bytes/s, so rate_units is calculated as:
+ *
+ *   ceil(rate_bytes_per_sec * 8 / 16000)
+ * = ceil(rate_bytes_per_sec / 2000)
+ *
+ * This avoids the premature truncation in a bytes/s -> kbit/s -> hardware
+ * unit conversion and guarantees the programmed representable rate is not
+ * lower than the requested Linux rate merely due to rounding.
+ */
+static int
+rtl8372n_igbw_program_locked(struct rtl837x_priv *priv, int port,
+			      u32 rate_units, u32 burst,
+			      struct rtl8372n_igbw_snapshot *snapshot)
+{
+	u32 burst_reg = RTL8373_IGBW_PORT_BURST_CTRL_ADDR(port);
+	u32 burst_high_off = burst / 2;
+	int ret;
+
+	ret = rtl8372n_igbw_snapshot_locked(priv, port, snapshot);
+	if (ret)
+		return ret;
+
+	/*
+	 * Avoid changing burst/rate values while an old policer instance is
+	 * active. The original enable state is restored by rollback if a
+	 * subsequent operation fails.
+	 */
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_BW_EN_MASK, 0);
+	if (ret)
+		goto restore;
+
+	/*
+	 * tc police accounts payload bytes. Exclude preamble/IFG from IGBW
+	 * accounting and turn off IGBW flow-control so excess traffic is
+	 * dropped instead of being paused.
+	 */
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_CTRL_ADDR,
+		RTL8373_IGBW_CTRL_INC_IFG_MASK, 0);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_FC_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_FC_CTRL_EN_MASK(port), 0);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_drop_write_verify_locked(priv, port, burst);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_burst_write_verify_locked(priv, burst_reg, burst);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_burst_write_verify_locked(priv, burst_reg + 4,
+						       burst_high_off);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_RATE_MASK, rate_units);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_BW_EN_MASK, 1);
+	if (ret)
+		goto restore;
+
+	ret = rtl8372n_igbw_reset_locked(priv, port);
+	if (!ret)
+		return 0;
+
+restore:
+	rtl8372n_igbw_restore_locked(priv, port, snapshot);
+	return ret;
+}
+
+static int
+rtl8372n_port_policer_add(struct dsa_switch *ds, int port,
+			  struct dsa_mall_policer_tc_entry *policer)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	struct rtl8372n_igbw_snapshot snapshot;
+	u64 rate_units;
+	u16 port_bit;
+	bool first_policer;
+	bool already_active;
+	int ret;
+
+	if (!rtl8372n_port_is_user(ds, port))
+		return -EOPNOTSUPP;
+
+	/*
+	 * dsa_mall_policer_tc_entry exposes only byte-rate and byte-burst.
+	 * DSA core rejects police modes/actions that are not representable
+	 * through this callback, including packet rate, peakrate, avrate,
+	 * overhead, or a non-pass/non-drop action combination.
+	 */
+	rate_units = DIV_ROUND_UP_ULL(policer->rate_bytes_per_sec,
+				      RTL8372N_IGBW_RATE_UNIT_BPS / 8);
+
+	if (!rate_units ||
+	    rate_units > FIELD_MAX(RTL8373_IGBW_PORT_CTRL_RATE_MASK) ||
+	    policer->burst < RTL8372N_IGBW_BURST_MIN ||
+	    policer->burst > RTL8372N_IGBW_BURST_FIELD_MASK)
+		return -ERANGE;
+
+	port_bit = BIT(port);
+
+	mutex_lock(&chip_data->config_lock);
+
+	already_active = !!(chip_data->igbw_policer_mask & port_bit);
+	first_policer = !chip_data->igbw_policer_mask;
+
+	ret = rtl8372n_igbw_program_locked(priv, port, (u32)rate_units,
+					   policer->burst, &snapshot);
+	if (ret)
+		goto out_unlock;
+
+	/*
+	 * Preserve the state from before the first successful ownership of
+	 * this port. Replacing an existing DSA policer must not overwrite
+	 * the original flow-control or global IFG state with its currently
+	 * forced-off values.
+	 */
+	if (!already_active) {
+		chip_data->igbw_fc_restore[port] = snapshot.flow_control;
+		chip_data->igbw_policer_mask |= port_bit;
+	}
+
+	if (first_policer) {
+	chip_data->igbw_inc_ifg_restore = snapshot.include_ifg;
+		chip_data->igbw_inc_ifg_saved = true;
+	}
+
+out_unlock:
+	mutex_unlock(&chip_data->config_lock);
+
+	return ret;
+}
+
+static void rtl8372n_port_policer_del(struct dsa_switch *ds, int port)
+{
+	struct rtl837x_priv *priv = ds->priv;
+	struct rtl8372n *chip_data = priv->chip_data;
+	u16 port_bit;
+	bool restore_ifg;
+	bool restore_fc;
+	bool active;
+	int first_error = 0;
+	int ret;
+
+	if (!rtl8372n_port_is_user(ds, port))
+		return;
+
+	port_bit = BIT(port);
+
+	mutex_lock(&chip_data->config_lock);
+
+	active = !!(chip_data->igbw_policer_mask & port_bit);
+	if (!active)
+		goto out_unlock;
+
+	restore_fc = chip_data->igbw_fc_restore[port];
+	restore_ifg = chip_data->igbw_inc_ifg_saved &&
+		      chip_data->igbw_policer_mask == port_bit;
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_CTRL_BW_EN_MASK, 0);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	/*
+	 * Clear token state even when disabling returned an error: the
+	 * register write may have reached the switch before MDIO reported
+	 * the transaction failure.
+	 */
+	ret = rtl8372n_igbw_reset_locked(priv, port);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	ret = rtl8372n_igbw_field_write_verify_locked(
+		priv, RTL8373_IGBW_PORT_FC_CTRL_ADDR(port),
+		RTL8373_IGBW_PORT_FC_CTRL_EN_MASK(port), restore_fc);
+	rtl8372n_igbw_record_error(&first_error, ret);
+
+	/*
+	 * INCLUDE_IFG is global. Keep it cleared while any ingress policer
+	 * remains active and restore the pre-driver value only after the
+	 * final active port has been removed.
+	 */
+	if (restore_ifg) {
+		ret = rtl8372n_igbw_field_write_verify_locked(
+			priv, RTL8373_IGBW_CTRL_ADDR,
+			RTL8373_IGBW_CTRL_INC_IFG_MASK,
+			chip_data->igbw_inc_ifg_restore);
+		rtl8372n_igbw_record_error(&first_error, ret);
+	}
+
+	/*
+	 * port_policer_del() cannot report an error to DSA. Make a complete
+	 * best-effort hardware cleanup and release software ownership even
+	 * if MDIO access failed; a subsequent add will take a fresh hardware
+	 * snapshot instead of retaining stale restore state.
+	 */
+	chip_data->igbw_policer_mask &= ~port_bit;
+	chip_data->igbw_fc_restore[port] = false;
+
+	if (!chip_data->igbw_policer_mask) {
+		chip_data->igbw_inc_ifg_restore = false;
+		chip_data->igbw_inc_ifg_saved = false;
+	}
+
+out_unlock:
+	mutex_unlock(&chip_data->config_lock);
+
+	if (first_error)
+		dev_err(priv->dev,
+			"failed to disable ingress policer on port %d: %d\n",
+			port, first_error);
+}
